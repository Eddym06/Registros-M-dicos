{
  "manifest_version": 3,
  "name": "Registros Médicos",
  "version": "1.0.0",
  "description": "Sistema de gestión de registros médicos con almacenamiento local seguro",
  "permissions": [
    "storage",
    "nativeMessaging",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5847/*",
    "http://127.0.0.1:5847/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
